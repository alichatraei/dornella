
# nginx خود سرور، پورت ۴۴۳: کل دامنه به nginx داخل داکر می‌رود
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name DOMAIN_HERE www.DOMAIN_HERE;

    ssl_certificate     /home/dornela/deploy/certbot/conf/live/DOMAIN_HERE/fullchain.pem;
    ssl_certificate_key /home/dornela/deploy/certbot/conf/live/DOMAIN_HERE/privkey.pem;

    # آپلود چند عکس محصول با هم
    client_max_body_size 120m;

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
