# ═══ تنظیمات سرور درنلا ═══  (cp .env.example .env  و بعد مقدارها را پر کنید)

# دامنه بدون https و بدون www
DOMAIN=dornela.ir
# ایمیل برای گواهی SSL (هشدارهای تمدید به این ایمیل می‌آید)
CERTBOT_EMAIL=you@example.com
# اگر زیردامنه www در DNS تعریف نشده، false کنید
CERT_WWW=true
# اگر پورت ۸۰ یا ۴۴۳ سرور را سرویس دیگری گرفته (در این حالت هر سه خط را با هم فعال کنید):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# SITE_ORIGIN=https://dornela.ir:8443
# اگر Let's Encrypt از سرور در دسترس نیست (فیلتر)، از ZeroSSL استفاده کنید:
# ACME_SERVER=https://acme.zerossl.com/v2/DV90
# ACME_EAB_KID=
# ACME_EAB_HMAC_KEY=

# رمز پایگاه داده و کلید امنیتی — هر دو را با این دستور بسازید:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# ورود مدیر در  https://دامنه/admin/login  با ایمیل یا شماره موبایل
ADMIN_PHONE=09135459772
ADMIN_EMAIL=admin@dornela.ir
ADMIN_PASSWORD=
# اگر رمز مدیر را فراموش کردید: رمز جدید را بالا بگذارید، این را true کنید، سرویس api را ری‌استارت و دوباره false کنید
ADMIN_RESET_PASSWORD=false

# ─── پیامک ─── kavenegar یا smsir  (console یعنی فقط در لاگ سرور)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=
# قالب پیامک کد ورود (کاوه‌نگار: نام قالب با پارامتر token — sms.ir: شماره قالب با پارامتر CODE)
SMS_OTP_TEMPLATE=

# ─── زرین‌پال ───
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ─── سرور داخل ایران ───
# اگر Docker Hub در دسترس نیست، آینه داخلی (با / در آخر). نمونه‌ها: docker.arvancloud.ir/  یا  focker.ir/
IMAGE_PREFIX=
# اگر نصب بسته‌های alpine کند یا قطع است، مثلاً: https://mirror.arvancloud.ir/alpine
ALPINE_MIRROR=
# اگر npm کند است، آینه npm (اختیاری)
# NPM_REGISTRY=https://registry.npmjs.org/
