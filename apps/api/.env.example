# ─── پایگاه داده ───
DATABASE_URL="postgresql://dornela:dornela@localhost:5432/dornela?schema=public"

# ─── امنیت ─── (حداقل ۳۲ کاراکتر تصادفی؛ مثلاً: openssl rand -hex 32)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"

# ─── آدرس‌ها ───
PORT=4000
WEB_ORIGIN="http://localhost:3000"
SITE_URL="http://localhost:3000"
PUBLIC_URL="http://localhost:4000"

# ─── حساب مدیر (اولین اجرا ساخته می‌شود) ───
ADMIN_PHONE="09135459772"
ADMIN_EMAIL="admin@dornela.ir"
ADMIN_PASSWORD="یک-رمز-قوی"
ADMIN_RESET_PASSWORD=false

# ─── پیامک ─── kavenegar | smsir | console
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=
# نام قالب (کاوه‌نگار) یا شماره قالب (sms.ir) برای کد ورود؛ پارامتر قالب: token در کاوه‌نگار / CODE در sms.ir
SMS_OTP_TEMPLATE=

# ─── زرین‌پال ───
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
